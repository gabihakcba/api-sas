// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// MODELOS
//

//
// Tablas relacionas a informacion basica de los usuarios:
// @Cuenta
// @Miembro
// @Protagonista
// @Adulto
// @Responsable
// @Relacion
// @Responsabilidad
//
model Cuenta {
  id       Int    @id @default(autoincrement())
  user     String @unique
  password String

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  Miembro    Miembro?     @relation(name: "MiembroCuenta")
  CuentaRole CuentaRole[] @relation(name: "CuentaRole")
}

model Miembro {
  id                  Int      @id @default(autoincrement())
  nombre              String
  apellidos           String
  dni                 String   @unique
  fecha_nacimiento    DateTime
  direccion           String
  email               String?  @unique
  telefono            String?
  telefono_emergencia String
  totem               String?
  cualidad            String?
  firma               Bytes?

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_cuenta Int @unique

  // Foreign key relations
  Cuenta Cuenta @relation(fields: [id_cuenta], references: [id], name: "MiembroCuenta")

  // Relations
  Protagonista          Protagonista?           @relation(name: "MiembroProtagnista")
  Adulto                Adulto?                 @relation(name: "MiembroAdulto")
  Responsable           Responsable?            @relation(name: "MiembroResponsable")
  MiembroRama           MiembroRama[]           @relation(name: "MiembroRamaMiembro")
  ParticipantesComision ParticipantesComision[] @relation(name: "ParticipantesComisionMiembro")
  InscripcionEvento     InscripcionEvento[]     @relation(name: "InscripcionEventoMiembro")
  Pago                  Pago[]                  @relation(name: "PagoMiembro")
  PagoResponsable       Pago[]                  @relation(name: "PagoResponsable")
  AsistenciaConsejo     AsistenciaConsejo[]     @relation(name: "AsistenciaMiembro")
  CuentaDinero          CuentaDinero[]          @relation(name: "CuentaMiembro")
  ConsejoModerado       Consejo[]               @relation(name: "ConsejoModerador")
  ConsejoSecretariado   Consejo[]               @relation(name: "ConsejoSecretario")
  ConsejoProsecretaria  Consejo[]               @relation(name: "ConsejoProsecretario")
}

model Protagonista {
  id        Int     @id @default(autoincrement())
  es_becado Boolean @default(false)
  activo    Boolean @default(true)

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_miembro Int @unique

  // Foreign key relations
  Miembro Miembro @relation(fields: [id_miembro], references: [id], name: "MiembroProtagnista")

  // Relations
  Responsabilidad Responsabilidad[] @relation(name: "ResponsabilidadProtagonista")
}

model Adulto {
  id        Int     @id @default(autoincrement())
  es_becado Boolean @default(false)
  activo    Boolean @default(true)

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_miembro Int @unique

  // Foreign key relations
  Miembro Miembro @relation(fields: [id_miembro], references: [id], name: "MiembroAdulto")

  // Relations
  EquipoArea           EquipoArea[]               @relation(name: "EquipoAreaAdulto")
  PlanDesempenoAdulto  PlanDesempenoAdulto[]      @relation(name: "PlanDesempenoAdultoAdulto")
  PlanDesempenoComoAPF PlanDesempenoAdulto[]      @relation(name: "PlanDesempenoAdultoAPF")
  CompetenciaValidada  PlanDesempenoCompetencia[] @relation(name: "PlanDesempenoCompetenciaValidador")
  AsignacionesAPF      AsignacionAPF[]            @relation(name: "AsignacionAPFAdulto")
}

model Responsable {
  id Int @id @default(autoincrement())

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_miembro Int @unique

  // Foreign key relations
  Miembro Miembro @relation(fields: [id_miembro], references: [id], name: "MiembroResponsable")

  // Relations
  Responsabilidad Responsabilidad[] @relation(name: "ResponsabilidadResponsable")
}

model Relacion {
  id          Int     @id @default(autoincrement())
  tipo        String // Madre - Padre - Abuelo - Tutor ...
  descripcion String?

  // Relations
  Responsabilidad Responsabilidad[] @relation(name: "ResponsabilidadRelacion")
}

model Responsabilidad {
  id Int @id @default(autoincrement())

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_protagonista Int
  id_responsable  Int
  id_relacion     Int

  // Foreign keys relations
  Protagonista Protagonista @relation(fields: [id_protagonista], references: [id], name: "ResponsabilidadProtagonista")
  Responsable  Responsable  @relation(fields: [id_responsable], references: [id], name: "ResponsabilidadResponsable")
  Relacion     Relacion     @relation(fields: [id_relacion], references: [id], name: "ResponsabilidadRelacion")

  @@unique([id_protagonista, id_responsable])
}

//
// Tablas para Areas
// @Area
// @Rama (Subarea)
// @EquipoArea
// @Rama
// @PosicionArea
// @MiembroRama
//

model Area {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique // Jefatura - Tesoreria - Secretaria - Intendencia - Rama
  descripcion String?

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  EquipoArea            EquipoArea[]            @relation(name: "EquipoAreaArea")
  AreaAfectada          AreaAfectada[]          @relation(name: "AreaAfectadaArea")
  CuentaDinero          CuentaDinero[]          @relation(name: "CuentaArea")
  PlanFormacionTemplate PlanFormacionTemplate[] @relation(name: "PlanFormacionTemplateArea")
  Rama                  Rama[]                  @relation(name: "RamaArea")
}

model EquipoArea {
  id           Int       @id @default(autoincrement())
  fecha_inicio DateTime
  fecha_fin    DateTime?
  activo       Boolean   @default(true)

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_area     Int
  id_adulto   Int
  id_posicion Int
  id_rama     Int?

  // Foreign key relations
  Area     Area         @relation(fields: [id_area], references: [id], name: "EquipoAreaArea")
  Adulto   Adulto       @relation(fields: [id_adulto], references: [id], name: "EquipoAreaAdulto")
  Posicion PosicionArea @relation(fields: [id_posicion], references: [id], name: "EquipoAreaPosicionArea")
  Rama     Rama?        @relation(fields: [id_rama], references: [id], name: "EquipoAreaRama")
}

model Rama {
  id                        Int     @id @default(autoincrement())
  nombre                    String  @unique // Castores - Manada - Unidad - Caminantes - Rovers
  descripcion               String?
  edad_minima_protagonistas Int
  edad_maxima_protagonistas Int
  edad_minima_adulto        Int

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_area Int

  // Foreign key relations
  Area Area @relation(fields: [id_area], references: [id], name: "RamaArea")

  // Relations
  MiembroRama  MiembroRama[]  @relation(name: "MiembroRamaRama")
  EquipoArea   EquipoArea[]   @relation(name: "EquipoAreaRama")
  CuentaDinero CuentaDinero[] @relation(name: "CuentaRama")
  RamaAfectada RamaAfectada[] @relation(name: "RamaAfectadaRama")
  CicloPrograma CicloPrograma[] @relation(name: "CicloProgramaRama")
}

model PosicionArea {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique // Jefe - Subjefe - Secretario - Tesorero - Ayudante
  descripcion String?

  // Relations
  EquipoArea EquipoArea[] @relation(name: "EquipoAreaPosicionArea")
}

model MiembroRama {
  id         Int @id @default(autoincrement())
  id_miembro Int
  id_rama    Int

  fecha_ingreso DateTime  @default(now())
  fecha_egreso  DateTime?

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign key relations
  Miembro Miembro @relation(fields: [id_miembro], references: [id], name: "MiembroRamaMiembro")
  Rama    Rama    @relation(fields: [id_rama], references: [id], name: "MiembroRamaRama")
}

//
// Tablas para eventos y actividades
// @Evento
// @TipoEvento
// @Comision
// @ParticipantesComision
// @AreaAfectada
// @InscripcionEvento
//
model Evento {
  id             Int      @id @default(autoincrement())
  nombre         String
  descripcion    String?
  fecha_inicio   DateTime
  fecha_fin      DateTime
  lugar          String?
  terminado      Boolean  @default(false)
  costo_mp       Decimal  @db.Decimal(15, 2)
  costo_ma       Decimal  @db.Decimal(15, 2)
  costo_ayudante Decimal  @db.Decimal(15, 2)

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_tipo           Int
  id_ciclo_programa Int?

  // Foreign key relations
  TipoEvento    TipoEvento     @relation(fields: [id_tipo], references: [id], name: "EventoTipoEvento")
  CicloPrograma CicloPrograma? @relation(fields: [id_ciclo_programa], references: [id], name: "EventoCicloPrograma")

  // Relations
  Comision          Comision[]          @relation(name: "ComisionEvento")
  AreaAfectada      AreaAfectada[]      @relation(name: "AreaAfectadaEvento")
  RamaAfectada      RamaAfectada[]      @relation(name: "RamaAfectadaEvento")
  InscripcionEvento InscripcionEvento[] @relation(name: "InscripcionEventoEvento")
  Pago              Pago[]              @relation(name: "PagoEvento")

  @@index([id_ciclo_programa])
}

model CicloPrograma {
  id            Int          @id @default(autoincrement())
  nombre        String
  descripcion   String?
  fecha_inicio  DateTime
  fecha_fin     DateTime
  estado        ESTADO_CICLO @default(DIAGNOSTICO)
  diagnostico   String?      @db.Text
  planificacion String?      @db.Text
  desarrollo    String?      @db.Text
  evaluacion    String?      @db.Text

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  id_rama Int

  Rama   Rama     @relation(fields: [id_rama], references: [id], name: "CicloProgramaRama")
  Evento Evento[] @relation(name: "EventoCicloPrograma")

  @@index([id_rama, borrado])
  @@index([id_rama, estado, borrado])
  @@index([fecha_inicio, fecha_fin])
}

model TipoEvento {
  id          Int     @id @default(autoincrement())
  nombre      String // Campamento - Salida cercana - RAID - Rally - Acantonamiento
  descripcion String?
  borrado     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relations
  Evento Evento[] @relation(name: "EventoTipoEvento")
}

model Comision {
  id          Int     @id @default(autoincrement())
  nombre      String
  descripcion String?

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign key
  id_evento Int?

  // Foreign key relations
  Evento Evento? @relation(fields: [id_evento], references: [id], name: "ComisionEvento")

  // Relations
  ParticipantesComision ParticipantesComision[] @relation(name: "ParticipantesComisionComision")
}

model ParticipantesComision {
  id           Int       @id @default(autoincrement())
  fecha_inicio DateTime  @default(now())
  fecha_fin    DateTime?

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_comision Int
  id_miembro  Int

  // Foreign key relations
  Comision Comision @relation(fields: [id_comision], references: [id], name: "ParticipantesComisionComision")
  Miembro  Miembro  @relation(fields: [id_miembro], references: [id], name: "ParticipantesComisionMiembro")
}

model AreaAfectada {
  id Int @id @default(autoincrement())

  // Foreign keys
  id_evento Int
  id_area   Int

  // Foreign key relations
  Evento Evento @relation(fields: [id_evento], references: [id], name: "AreaAfectadaEvento")
  Area   Area   @relation(fields: [id_area], references: [id], name: "AreaAfectadaArea")
}

model RamaAfectada {
  id Int @id @default(autoincrement())

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_evento Int
  id_rama   Int

  // Foreign key relations
  Evento Evento @relation(fields: [id_evento], references: [id], name: "RamaAfectadaEvento")
  Rama   Rama   @relation(fields: [id_rama], references: [id], name: "RamaAfectadaRama")
}

model InscripcionEvento {
  id              Int     @id @default(autoincrement())
  descripcion     String?
  asistio         Boolean @default(false)
  pagado          Boolean @default(false)
  monto_total     Decimal @default(0) @db.Decimal(15, 2)
  saldo_pendiente Decimal @default(0) @db.Decimal(15, 2)

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_evento  Int
  id_miembro Int

  // Foreign key relations
  Evento  Evento  @relation(fields: [id_evento], references: [id], name: "InscripcionEventoEvento")
  Miembro Miembro @relation(fields: [id_miembro], references: [id], name: "InscripcionEventoMiembro")
}

//
// Tablas para manejo de pagos
// @Pago
// @ConceptoPago
// @MetodoPago
// @CuentaDinero
//
model Pago {
  id                      Int      @id @default(autoincrement())
  monto                   Decimal  @db.Decimal(15, 2)
  detalles                String?
  comprobante_pago        Bytes?
  comprobante_pago_mime   String?
  comprobante_pago_nombre String?
  fecha_pago              DateTime @default(now())
  codigo_validacion       String   @unique @default(uuid())

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_cuenta_dinero Int
  id_metodo_pago   Int
  id_concepto_pago Int
  id_evento        Int?
  id_miembro       Int
  id_cuenta_origen Int?
  id_responsable   Int?

  // Foreign key relations
  CuentaDinero CuentaDinero  @relation(fields: [id_cuenta_dinero], references: [id], name: "PagoCuentaDinero")
  MetodoPago   MetodoPago    @relation(fields: [id_metodo_pago], references: [id], name: "PagoMetodoPago")
  ConceptoPago ConceptoPago  @relation(fields: [id_concepto_pago], references: [id], name: "PagoConceptoPago")
  Evento       Evento?       @relation(fields: [id_evento], references: [id], name: "PagoEvento")
  Miembro      Miembro       @relation(fields: [id_miembro], references: [id], name: "PagoMiembro")
  Responsable  Miembro?      @relation(fields: [id_responsable], references: [id], name: "PagoResponsable")
  CuentaOrigen CuentaDinero? @relation(fields: [id_cuenta_origen], references: [id], name: "PagoCuentaOrigen")
}

model ConceptoPago {
  id          Int     @id @default(autoincrement())
  nombre      String // Afiliacion - Cuota - Evento
  descripcion String?

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  Pago Pago[] @relation(name: "PagoConceptoPago")
}

model MetodoPago {
  id          Int     @id @default(autoincrement())
  nombre      String // Transferencia - Efectivo - Debito - Cheque
  descripcion String?

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  Pago Pago[] @relation(name: "PagoMetodoPago")
}

model CuentaDinero {
  id           Int     @id @default(autoincrement())
  nombre       String // Efectivo - Banco
  descripcion  String? // Numero de cuenta - Caja personal
  monto_actual Decimal @default(0) @db.Decimal(15, 2)

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_area    Int?
  id_rama    Int?
  id_miembro Int?

  // Foreign key relations
  Area    Area?    @relation(fields: [id_area], references: [id], name: "CuentaArea")
  Rama    Rama?    @relation(fields: [id_rama], references: [id], name: "CuentaRama")
  Miembro Miembro? @relation(fields: [id_miembro], references: [id], name: "CuentaMiembro")

  // Relations
  Pago       Pago[] @relation(name: "PagoCuentaDinero")
  PagoOrigen Pago[] @relation(name: "PagoCuentaOrigen")
}

//
// Tablas para formacion de adultos
// @PlanFormacionTemplate
// @PlanFormacionNivelTemplate
// @PlanFormacionCompetenciaTemplate
// @PlanFormacionComportamientoTemplate
// @PlanFormacionAprendizajeTemplate
// @PlanFormacionResultadoTemplate
// @AdjuntoFormacionTemplate
// @PlanDesempenoAdulto
// @PlanDesempenoCompetencia
// @PlanDesempenoCertificado
//
enum TIPO_COMPETENCIA_FORMACION {
  ESENCIAL
  ESPECIFICA
}

enum ESTADO_PLAN_DESEMPENO {
  BORRADOR
  EN_CURSO
  FINALIZADO
  APROBADO
}

model PlanFormacionTemplate {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?
  activo      Boolean @default(true)

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_area Int

  // Foreign key relations
  Area Area @relation(fields: [id_area], references: [id], name: "PlanFormacionTemplateArea")

  // Relations
  Niveles         PlanFormacionNivelTemplate[] @relation(name: "PlanFormacionNivelTemplatePlan")
  Adjuntos        AdjuntoFormacionTemplate[]   @relation(name: "AdjuntoFormacionTemplatePlan")
  PlanesDesempeno PlanDesempenoAdulto[]        @relation(name: "PlanDesempenoAdultoPlan")
}

model PlanFormacionNivelTemplate {
  id          Int     @id @default(autoincrement())
  orden       Int
  nombre      String // Nivel 1 - Etapa Basica, etc.
  descripcion String?

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_plan_formacion_template Int

  // Foreign key relations
  PlanFormacionTemplate PlanFormacionTemplate @relation(fields: [id_plan_formacion_template], references: [id], name: "PlanFormacionNivelTemplatePlan")

  // Relations
  Competencias PlanFormacionCompetenciaTemplate[] @relation(name: "PlanFormacionCompetenciaTemplateNivel")
  Certificados PlanDesempenoCertificado[]         @relation(name: "PlanDesempenoCertificadoNivel")

  @@unique([id_plan_formacion_template, orden])
}

model PlanFormacionCompetenciaTemplate {
  id          Int                        @id @default(autoincrement())
  nombre      String
  descripcion String?
  tipo        TIPO_COMPETENCIA_FORMACION

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_nivel_template Int

  // Foreign key relations
  Nivel PlanFormacionNivelTemplate @relation(fields: [id_nivel_template], references: [id], name: "PlanFormacionCompetenciaTemplateNivel")

  // Relations
  Comportamientos     PlanFormacionComportamientoTemplate[] @relation(name: "PlanFormacionComportamientoTemplateCompetencia")
  Aprendizajes        PlanFormacionAprendizajeTemplate[]    @relation(name: "PlanFormacionAprendizajeTemplateCompetencia")
  ResultadosEsperados PlanFormacionResultadoTemplate[]      @relation(name: "PlanFormacionResultadoTemplateCompetencia")
  CompetenciasAdulto  PlanDesempenoCompetencia[]            @relation(name: "PlanDesempenoCompetenciaTemplate")
  Certificados        PlanDesempenoCertificado[]            @relation(name: "PlanDesempenoCertificadoCompetencia")
}

model PlanFormacionComportamientoTemplate {
  id          Int    @id @default(autoincrement())
  descripcion String
  orden       Int

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_competencia_template Int

  // Foreign key relations
  Competencia PlanFormacionCompetenciaTemplate @relation(fields: [id_competencia_template], references: [id], name: "PlanFormacionComportamientoTemplateCompetencia")

  @@unique([id_competencia_template, orden])
}

model PlanFormacionAprendizajeTemplate {
  id          Int     @id @default(autoincrement())
  descripcion String
  obligatoria Boolean @default(true)
  orden       Int

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_competencia_template Int

  // Foreign key relations
  Competencia PlanFormacionCompetenciaTemplate @relation(fields: [id_competencia_template], references: [id], name: "PlanFormacionAprendizajeTemplateCompetencia")

  @@unique([id_competencia_template, orden])
}

model PlanFormacionResultadoTemplate {
  id          Int    @id @default(autoincrement())
  descripcion String
  orden       Int

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_competencia_template Int

  // Foreign key relations
  Competencia PlanFormacionCompetenciaTemplate @relation(fields: [id_competencia_template], references: [id], name: "PlanFormacionResultadoTemplateCompetencia")

  @@unique([id_competencia_template, orden])
}

model AdjuntoFormacionTemplate {
  id             Int     @id @default(autoincrement())
  titulo         String
  descripcion    String?
  archivo        Bytes?
  archivo_mime   String?
  archivo_nombre String

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_plan_formacion_template Int

  // Foreign key relations
  PlanFormacionTemplate PlanFormacionTemplate @relation(fields: [id_plan_formacion_template], references: [id], name: "AdjuntoFormacionTemplatePlan")

  @@unique([id_plan_formacion_template, archivo_nombre])
}

model PlanDesempenoAdulto {
  id                      Int                   @id @default(autoincrement())
  anio                    Int
  estado                  ESTADO_PLAN_DESEMPENO @default(BORRADOR)
  fecha_inicio            DateTime              @default(now())
  fecha_cierre            DateTime?
  observaciones_generales String?

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_adulto                  Int
  id_plan_formacion_template Int
  id_apf_adulto              Int

  // Foreign key relations
  Adulto                Adulto                @relation(fields: [id_adulto], references: [id], name: "PlanDesempenoAdultoAdulto")
  PlanFormacionTemplate PlanFormacionTemplate @relation(fields: [id_plan_formacion_template], references: [id], name: "PlanDesempenoAdultoPlan")
  APF                   Adulto                @relation(fields: [id_apf_adulto], references: [id], name: "PlanDesempenoAdultoAPF")

  // Relations
  Competencias PlanDesempenoCompetencia[] @relation(name: "PlanDesempenoCompetenciaPlan")
  Certificados PlanDesempenoCertificado[] @relation(name: "PlanDesempenoCertificadoPlan")

  @@unique([id_adulto, anio, id_plan_formacion_template])
}

model PlanDesempenoCompetencia {
  id               Int       @id @default(autoincrement())
  validada         Boolean   @default(false)
  observacion_apf  String?
  fecha_validacion DateTime?

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_plan_desempeno       Int
  id_competencia_template Int
  id_apf_validador        Int?

  // Foreign key relations
  Plan                PlanDesempenoAdulto              @relation(fields: [id_plan_desempeno], references: [id], name: "PlanDesempenoCompetenciaPlan")
  CompetenciaTemplate PlanFormacionCompetenciaTemplate @relation(fields: [id_competencia_template], references: [id], name: "PlanDesempenoCompetenciaTemplate")
  APFValidador        Adulto?                          @relation(fields: [id_apf_validador], references: [id], name: "PlanDesempenoCompetenciaValidador")

  @@unique([id_plan_desempeno, id_competencia_template])
}

model PlanDesempenoCertificado {
  id             Int       @id @default(autoincrement())
  titulo         String
  descripcion    String?
  archivo        Bytes?
  archivo_mime   String?
  archivo_nombre String?
  fecha_emision  DateTime?

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_plan_desempeno       Int
  id_competencia_template Int?
  id_nivel_template       Int?

  // Foreign key relations
  Plan                PlanDesempenoAdulto               @relation(fields: [id_plan_desempeno], references: [id], name: "PlanDesempenoCertificadoPlan")
  CompetenciaTemplate PlanFormacionCompetenciaTemplate? @relation(fields: [id_competencia_template], references: [id], name: "PlanDesempenoCertificadoCompetencia")
  NivelTemplate       PlanFormacionNivelTemplate?       @relation(fields: [id_nivel_template], references: [id], name: "PlanDesempenoCertificadoNivel")
}

//
// Tablas para consejo
// @Consejo
// @AsistenciaConsejo
// @TemarioConsejo
//
model Consejo {
  id               Int       @id @default(autoincrement())
  nombre           String
  descripcion      String?
  fecha            DateTime  @default(now())
  es_ordinario     Boolean   @default(true)
  hora_inicio      DateTime?
  hora_fin         DateTime?
  id_moderador     Int?
  id_secretario    Int?
  id_prosecretario Int?

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign key relations
  Moderador     Miembro? @relation(fields: [id_moderador], references: [id], name: "ConsejoModerador")
  Secretario    Miembro? @relation(fields: [id_secretario], references: [id], name: "ConsejoSecretario")
  Prosecretario Miembro? @relation(fields: [id_prosecretario], references: [id], name: "ConsejoProsecretario")

  // Relations
  AsistenciaConsejo AsistenciaConsejo[] @relation(name: "AsistenciaConsejoConsejo")
  TemarioConsejo    TemarioConsejo[]    @relation(name: "TemarioConsejoConsejo")
  AsignacionesAPF   AsignacionAPF[]     @relation(name: "AsignacionAPFConsejo")
}

model AsignacionAPF {
  id           Int       @id @default(autoincrement())
  fecha_inicio DateTime  @default(now())
  fecha_fin    DateTime?
  observacion  String?

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_adulto  Int
  id_consejo Int

  // Foreign key relations
  Adulto  Adulto  @relation(fields: [id_adulto], references: [id], name: "AsignacionAPFAdulto")
  Consejo Consejo @relation(fields: [id_consejo], references: [id], name: "AsignacionAPFConsejo")
}

model AsistenciaConsejo {
  id          Int    @id @default(autoincrement())
  descripcion String // Representante adulto - Representante juvenil - Invitado

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_consejo Int
  id_miembro Int

  // Foreign key relations
  Consejo Consejo @relation(fields: [id_consejo], references: [id], name: "AsistenciaConsejoConsejo")
  Miembro Miembro @relation(fields: [id_miembro], references: [id], name: "AsistenciaMiembro")
}

enum ESTADO_TEMARIO {
  PENDIENTE
  EN_TRATAMIENTO
  TRATADO
  POSPUESTO
}

enum ESTADO_CICLO {
  DIAGNOSTICO
  PLANIFICACION
  DESARROLLO
  EVALUACION
  FINALIZADO
}

model TemarioConsejo {
  id          Int            @id @default(autoincrement())
  titulo      String
  descripcion String?
  debate      String?
  acuerdo     String?
  sin_mp      Boolean        @default(false)
  estado      ESTADO_TEMARIO @default(PENDIENTE)

  borrado   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  id_consejo Int

  // Foreign key relations
  Consejo Consejo @relation(fields: [id_consejo], references: [id], name: "TemarioConsejoConsejo")
}

//
// Tablas para rastreo y mantenimiento
// @Logs
//
model Log {
  id        Int      @id @default(autoincrement())
  cuenta    Json
  miembro   Json
  endpoint  String
  timestamp DateTime @default(now())
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  // Relations
  Action Action[] @relation(name: "ActionLog")
}

model Action {
  id             Int      @id @default(autoincrement())
  tabla          String
  pre_registro   Json
  post_registro  Json?
  createdAt      DateTime @default(now())

  // Foreign key
  id_log Int

  // Foreign key relations
  Log Log @relation(fields: [id_log], references: [id], name: "ActionLog")
}

model ConfiguracionGrupo {
  id           Int      @id @default(1)
  nombre_grupo String   @default("Grupo Scout")
  url_logo     String?
  url_favicon  String?
  theme_web    String   @default("lara-light-blue")
  theme_mobile String   @default("md3-light")
  updatedAt    DateTime @updatedAt
}

//
// Tablas para permisos y roles
// @Role
// @Permission
// @RolePermission
// @CuentaRole
//
model Role {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique // ADM - DEV - OWN
  descripcion String?

  // Relations
  RolePermission RolePermission[]
  CuentaRole     CuentaRole[]
}

enum ACTION {
  CREATE
  READ
  UPDATE
  DELETE
  MANAGE
}

enum RESOURCE {
  CUENTA
  MIEMBRO
  PROTAGONISTA
  ADULTO
  RESPONSABLE
  AREA
  RAMA
  EVENTO
  INSCRIPCION
  PAGO
  PRESUPUESTO
  INVENTARIO
  PLAN_FORMACION
  ASISTENCIA
  CERTIFICADO
  CUENTA_DINERO
  TIPO_EVENTO
  LIBRO_ACTAS
  LOG
  ACTION
  ROLE
  RELACION
  CONCEPTO_PAGO
  METODO_PAGO
  COMISION
  PARTICIPANTE_COMISION
  CONSEJO
  ASISTENCIA_CONSEJO
  PLAN_DESEMPENO
  ADJUNTO_FORMACION
  CICLO_PROGRAMA
  CONFIGURACION_GRUPO
}

model Permission {
  id       Int      @id @default(autoincrement())
  action   ACTION
  resource RESOURCE

  // Relations
  Roles RolePermission[]

  @@unique([action, resource])
}

enum SCOPE {
  GRUPO
  RAMA
  AREA
  GLOBAL
  OWN
}

model RolePermission {
  id_role       Int
  id_permission Int

  // Foreign key relations
  Role       Role       @relation(fields: [id_role], references: [id])
  Permission Permission @relation(fields: [id_permission], references: [id])

  @@id([id_role, id_permission])
}

model CuentaRole {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  tipo_scope SCOPE    @default(GLOBAL)
  id_scope   Int?

  // Foreign keys
  id_cuenta Int
  id_role   Int

  // Foreign key relations
  Cuenta Cuenta @relation(fields: [id_cuenta], references: [id], name: "CuentaRole")
  Role   Role   @relation(fields: [id_role], references: [id])
}
